# Reset PATH
export USRBIN="/usr/bin"
export BIN="/bin"
export USRSBIN="/usr/sbin"
export SBIN="/sbin"
export USRLOCALBIN="/usr/local/bin"
export HOMELOCALSHAREBIN="$HOME/.local/share/../bin/env"
export NVIM_BOB="$HOME/.local/share/bob/nightly"
export NVIM_BOB_BIN="$HOME/.local/share/bob/nvim-bin"
export HOMELOCALBIN="$HOME/.local/bin"

export PATH=$NVIM_BOB_BIN:$USRLOCALBIN:$USRBIN:$BIN:$USRSBIN:$SBIN:$HOMELOCALBIN:$HOMELOCALSHAREBIN

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="darkblood"

# Reminder to update Oh-My-Zsh.
zstyle ':omz:update' mode reminder

# Remind to update Oh-My-Zsh every 7 days.
zstyle ':omz:update' frequency 7

# Enable corrections and waiting dots
#ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Load secrets (file not in version control)
if [ -f ~/.secrets ]; then
    source ~/.secrets
fi

# SSH Agent
if ! pgrep -u "$USER" ssh-agent > /dev/null; then
    ssh-agent -t 8h > "$XDG_RUNTIME_DIR/ssh-agent.env"
fi
if [[ ! -f "$SSH_AUTH_SOCK" ]]; then
    source "$XDG_RUNTIME_DIR/ssh-agent.env" >/dev/null
fi

# GPG Client
export GPG_TTY=$(tty)

# User configuration
# Set aliases.
alias zshconfig="vim ~/.zshrc"
alias restartzsh="source ~/.zshrc"
alias vim=nvim
alias sudo="sudo "
alias fpr="git stash && git switch main && git pull && git stash pop"
alias cd="z"
alias cdi="zi"
alias lg="lazygit"
alias tree="tree -a -I .git --gitignore"
alias c="clear"
beersnap() {
  emulate -L zsh
  setopt pipe_fail

  local snapshot_dir="$HOME/code/10000-beers-analysis/snapshots"
  if [[ ! -d "$snapshot_dir" ]]; then
    print -u2 "Snapshot directory does not exist: $snapshot_dir"
    return 1
  fi

  local count timestamp output temporary
  count=$(ssh ninkasi 'docker exec beers-postgres psql -U beers -d beers -Atc "SELECT COUNT(*) FROM beers"') || return 1
  if [[ "$count" != <-> ]]; then
    print -u2 "Could not determine the current beer count"
    return 1
  fi

  timestamp=$(date +%Y-%m-%d_%H%M%S)
  output="$snapshot_dir/${timestamp}__${count}-beers.sql.gz"
  temporary="${output}.tmp"

  if ssh ninkasi 'docker exec beers-postgres pg_dump -U beers -d beers --clean --if-exists' | gzip > "$temporary"; then
    command mv "$temporary" "$output"
    print -r -- "$output"
  else
    command rm -f "$temporary"
    print -u2 "Snapshot failed"
    return 1
  fi
}

# NVM
export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Go
export PATH=$PATH:/usr/local/go/bin

# Rust
export PATH=$PATH:$HOME/.cargo/bin

# Docker - New build system
export DOCKER_BUILDKIT=1

# Oh-My-Posh
eval "$(oh-my-posh init zsh --config ~/theme/gabriel.omp.json)"

# Zoxide (need to be at the end)
eval "$(zoxide init zsh)"
