# Reset PATH
export USRBIN="/usr/bin"
export BIN="/bin"
export USRSBIN="/usr/sbin"
export SBIN="/sbin"
export USRLOCALBIN="/usr/local/bin"
export NVIM_BOB="$HOME/.local/share/bob/nightly"
export NVIM_BOB_BIN="$HOME/.local/share/bob/nvim-bin"
export HOMELOCALBIN="$HOME/.local/bin"

export PATH=$NVIM_BOB_BIN:$USRLOCALBIN:$USRBIN:$BIN:$USRSBIN:$SBIN:$HOMELOCALBIN

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME="darkblood"

# Reminder to update Oh-My-Zsh.
zstyle ':omz:update' mode reminder

# Remind to update Oh-My-Zsh every 7 days.
zstyle ':omz:update' frequency 7

# Enable corrections and waiting dots
#ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

# Standard plugins can be found in $ZSH/plugins/
# Custom plugins may be added to $ZSH_CUSTOM/plugins/
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Load secrets (file not in version control)
if [ -f ~/.secrets ]; then
    source ~/.secrets
fi

# User configuration
# Set aliases.
alias zshconfig="vim ~/.zshrc"
alias restartzsh="source ~/.zshrc"
alias vim=nvim
alias sudo="sudo "
alias fpr="git stash && git switch main && git pull && git stash pop"
alias cd="z"
alias cdi="zi"
alias lg="lazygit"
alias tree="tree -a -I .git --gitignore"
alias c="clear"

# NVM
export NVM_DIR="$HOME/.config/nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Oh-My-Posh
eval "$(oh-my-posh init zsh --config ~/theme/gabriel.omp.json)"

# Zoxide (need to be at the end)
eval "$(zoxide init zsh)"
