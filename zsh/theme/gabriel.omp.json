{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#c9c9c9",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "#c9c9c9",
          "properties": {
            "style": "folder"
          },
          "style": "plain",
          "template": "<#6b6b73>in</>",
          "type": "path"
        },
        {
          "type": "path",
          "foreground": "#ececec",
          "properties": {
            "style": "agnoster_short",
            "folder_separator_icon": "/",
            "home_icon": ""
          },
          "template": " {{ .Path }} "
        },
        {
          "type": "git",
          "foreground": "#6e94b2",
          "properties": {
            "branch_icon": " "
          },
          "style": "plain",
          "template": "<#6b6b73>on</> {{ .HEAD }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "diamond",
          "foreground": "#7fa563",
          "foreground_templates": [
            "{{ if .Error }}#d8647e{{ end }}"
          ],
          "template": "[  {{ .Code }}] ",
          "properties": {
            "always_enabled": true
          }
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#6b6b73",
          "template": "[ {{ .FormattedMs }}] ",
          "properties": {
            "threshold": 500,
            "style": "austin",
            "always_enabled": true
          }
        },
        {
          "foreground": "#9bb4bc",
          "type": "go",
          "style": "powerline",
          "template": "[  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] "
        },
        {
          "foreground": "#e8b589",
          "type": "python",
          "style": "powerline",
          "template": "[  {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Full }}{{ end }}{{ end }}] "
        },
        {
          "foreground": "#7fa563",
          "type": "node",
          "style": "powerline",
          "template": "[ {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] "
        },
        {
          "foreground": "#d8647e",
          "type": "ruby",
          "style": "powerline",
          "template": "[ {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] "
        },
        {
          "foreground": "#e8b589",
          "type": "java",
          "style": "powerline",
          "template": "[  {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }}] "
        },
        {
          "foreground": "#9bb4bc",
          "type": "dart",
          "style": "powerline",
          "template": "[ {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Full }}{{ end }}{{ end }}] "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#ececec",
          "style": "plain",
          "template": "❯",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 3
}