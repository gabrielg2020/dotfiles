{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["clock", "network", "bluetooth", "pulseaudio", "custom/pi-status"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["custom/local-ip", "cpu", "memory", "temperature", "load"],

    "clock": {
        "format": "[{:%H:%M}]",
        "tooltip": false
    },

    "network": {
        "format-wifi": "[󰖩 ]",
        "format-ethernet": "[󰈀 ]",
        "format-disconnected": "[󰖪 ]",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "nm-connection-editor"
    },

    "bluetooth": {
        "format": "[󰂯]",
        "format-disabled": "[󰂲]",
        "format-connected": "[󰂱]",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "blueman-manager"
    },

    "pulseaudio": {
        "format": "[󰕾]",
        "format-muted": "[󰖁]",
        "tooltip": false,
        "on-click": "pavucontrol"
    },

    "hyprland/workspaces": {
        "format": "[{name}]",
        "active-only": true
    },

    "cpu": {
        "format": "[CPU {usage}%]",
        "tooltip": false
    },

    "memory": {
        "format": "[MEM {used:0.1f}GB]",
        "tooltip": false
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "format": "[TEMP {temperatureC}°C]",
        "tooltip": false
    },

    "load": {
        "format": "[LOAD {load1}]",
        "tooltip": false
    },

    "custom/pi-status": {
        "format": "{}",
        "return-type": "json",
        "exec": "/home/blu/dotfiles/scripts/pi-status-waybar.sh",
        "interval": 10
    },

    "custom/local-ip": {
        "format": "[IP {}]",
        "exec": "/home/blu/dotfiles/scripts/local-ip.sh",
        "interval": 30
    }
}
