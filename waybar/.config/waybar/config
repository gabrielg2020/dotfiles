{
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-right": ["clock"],

    "hyprland/workspaces": {
        "format": "{name}",
        "active-only": false
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 80,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M:%S  %d/%m/%Y}",
        "interval": 1,
        "tooltip": false
    }
}
