// Noir fastfetch — minimal, mono keys, pastel values
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "white"
    },
    "padding": {
      "right": 3,
      "top": 1
    }
  },
  "display": {
    "separator": " -> ",
    "color": {
      "keys": "blue",
      "title": "white"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    "os",
    "kernel",
    "wm",
    "shell",
    "terminal",
    {
      "type": "custom",
      "format": "--------------------------------"
    },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "uptime",
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
