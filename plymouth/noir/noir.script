// Noir — near-black background, the cat, a minimal password readout,
// and a slow pulsing dot indicator while the system is working

Window.SetBackgroundTopColor(0.039, 0.039, 0.043);
Window.SetBackgroundBottomColor(0.039, 0.039, 0.043);

cat.image = Image("cat.png");
cat.sprite = Sprite(cat.image);
cat.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - cat.image.GetWidth() / 2);
cat.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - cat.image.GetHeight() - 30);

// Loading indicator: ". / .. / ..." cycling under the cat whenever no
// prompt is on screen — i.e. before the passphrase is asked for and
// while the passphrase is being checked / boot is continuing.
loading.frames[0] = ".";
loading.frames[1] = "..";
loading.frames[2] = "...";
loading.sprite = Sprite();
loading.tick = 0;
loading.frame = 0;
global.mode = "normal";

fun show_loading(frame) {
    image = Image.Text(loading.frames[frame], 0.42, 0.42, 0.45);
    loading.sprite.SetImage(image);
    loading.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - image.GetWidth() / 2);
    loading.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + 30);
    loading.sprite.SetOpacity(1);
}
show_loading(0);

fun refresh_callback() {
    if (global.mode != "normal")
        return;
    loading.tick++;
    if (loading.tick % 20 != 0)
        return;
    loading.frame = (loading.frame + 1) % 3;
    show_loading(loading.frame);
}
Plymouth.SetRefreshFunction(refresh_callback);

// Password prompt: a row of asterisks under the cat
fun display_password_callback(prompt, bullets) {
    global.mode = "password";
    loading.sprite.SetOpacity(0);

    dots = "";
    for (i = 0; i < bullets; i++)
        dots += "* ";
    if (bullets == 0)
        dots = "_";

    prompt_image = Image.Text(dots, 0.79, 0.79, 0.79);
    global.prompt_sprite = Sprite(prompt_image);
    global.prompt_sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - prompt_image.GetWidth() / 2);
    global.prompt_sprite.SetY(Window.GetY() + Window.GetHeight() / 2 + 30);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    global.mode = "normal";
    global.prompt_sprite = NULL;
    show_loading(loading.frame);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// Keep boot messages off the splash (Esc still shows the text log)
fun message_callback(text) {
}
Plymouth.SetMessageFunction(message_callback);
