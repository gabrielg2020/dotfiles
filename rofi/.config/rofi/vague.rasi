/**
 * Vague Theme for Rofi
 * Based on https://github.com/vague-theme/vague.nvim
 */

* {
    bg:                 #141415;
    inactive-bg:        #1c1c24;
    fg:                 #cdcdcd;
    comment:            #606079;
    builtin:            #b4d4cf;
    func:               #c48282;
    string:             #e8b589;
    keyword:            #6e94b2;
    type:               #9bb4bc;
    visual:             #333738;
    border:             #252530;

    background-color:   transparent;
    text-color:         @fg;
    font:               "FiraCode Nerd Font Mono 12";
}

window {
    transparency:       "real";
    background-color:   @bg;
    border:             2px;
    border-color:       @border;
    border-radius:      8px;
    width:              600px;
    padding:            20px;
}

mainbox {
    background-color:   transparent;
    children:           [inputbar, listview];
    spacing:            20px;
}

inputbar {
    background-color:   @inactive-bg;
    text-color:         @fg;
    border-radius:      6px;
    padding:            12px 16px;
    children:           [prompt, entry];
    spacing:            10px;
}

prompt {
    background-color:   transparent;
    text-color:         @keyword;
}

entry {
    background-color:   transparent;
    text-color:         @fg;
    placeholder:        "Search...";
    placeholder-color:  @comment;
}

listview {
    background-color:   transparent;
    lines:              8;
    spacing:            4px;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    text-color:         @fg;
    border-radius:      4px;
    padding:            8px 12px;
}

element selected {
    background-color:   @visual;
    text-color:         @string;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
}

element-icon {
    background-color:   transparent;
    size:               1.2em;
    padding:            0 8px 0 0;
}
