  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#606079",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable", "string constant.other.placeholder"],
      "settings": { "foreground": "#cdcdcd" }
    },
    {
      "scope": ["variable.parameter", "meta.parameter", "variable.parameter.function-call"],
      "settings": { "foreground": "#bb9dbd" }
    },
    {
      "scope": [
        "constant",
        "variable.other.constant",
        "variable.language",
        "support.constant",
        "constant.language",
        "constant.character",
        "constant.other"
      ],
      "settings": { "foreground": "#aeaed1" }
    },
    {
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": { "foreground": "#e0a363" }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#e8b589" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder", "string.regexp"],
      "settings": { "foreground": "#e0a363" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "storage.type.function.arrow"
      ],
      "settings": { "foreground": "#6e94b2" }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor",
        "punctuation.terminator",
        "meta.brace",
        "punctuation.section"
      ],
      "settings": { "foreground": "#90a0b5" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": { "foreground": "#c48282" }
    },
    {
      "scope": [
        "support.function.builtin",
        "support.type.builtin",
        "support.class.builtin",
        "constant.language.builtin"
      ],
      "settings": { "foreground": "#b4d4cf" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "meta.type"
      ],
      "settings": { "foreground": "#9bb4bc" }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.property",
        "support.type.property-name",
        "entity.name.tag.attribute-name",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#c3c3d5" }
    },
    {
      "scope": ["variable.other.member", "variable.other.field"],
      "settings": { "foreground": "#c3c3d5" }
    },
    {
      "scope": [
        "entity.name.tag",
        "meta.tag",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#6e94b2" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#bb9dbd" }
    },
    {
      "scope": ["entity.name.label", "entity.name.section", "markup.heading"],
      "settings": {
        "foreground": "#6e94b2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#e0a363" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#bb9dbd" }
    },
    {
      "scope": ["markup.underline"],
      "settings": { "fontStyle": "underline" }
    },
    {
      "scope": ["markup.strikethrough"],
      "settings": { "fontStyle": "strikethrough" }
    },
    {
      "scope": ["markup.quote"],
      "settings": { "foreground": "#606079", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#e8b589" }
    },
    {
      "scope": ["markup.list", "markup.list.bullet"],
      "settings": { "foreground": "#b4d4cf" }
    },
    {
      "scope": ["markup.inserted", "markup.inserted.diff"],
      "settings": { "foreground": "#7fa563" }
    },
    {
      "scope": ["markup.deleted", "markup.deleted.diff"],
      "settings": { "foreground": "#d8647e" }
    },
    {
      "scope": ["markup.changed", "markup.changed.diff"],
      "settings": { "foreground": "#f3be7c" }
    },
    {
      "scope": ["markup.link", "string.other.link"],
      "settings": { "foreground": "#bb9dbd", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#d8647e" }
    },
    {
      "scope": ["invalid.deprecated"],
      "settings": { "foreground": "#e08398", "fontStyle": "strikethrough" }
    },
    {
      "scope": ["meta.diff.header", "meta.diff.header.git"],
      "settings": { "foreground": "#7e98e8" }
    },
    {
      "scope": ["meta.diff.range"],
      "settings": { "foreground": "#bb9dbd" }
    },
    {
      "scope": ["meta.preprocessor", "keyword.control.directive"],
      "settings": { "foreground": "#bb9dbd" }
    },
    {
      "scope": ["meta.import", "meta.export", "keyword.control.import", "keyword.control.from"],
      "settings": { "foreground": "#6e94b2" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"],
      "settings": { "foreground": "#f3be7c" }
    },
    {
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": { "foreground": "#cdcdcd" }
    },
    {
      "scope": ["string.regexp punctuation.definition.string"],
      "settings": { "foreground": "#d8647e" }
    },
    {
      "scope": ["constant.character.escape.regexp"],
      "settings": { "foreground": "#e0a363" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#9bb4bc",
    "type": "#9bb4bc",
    "class": "#9bb4bc",
    "enum": "#9bb4bc",
    "interface": "#9bb4bc",
    "struct": "#9bb4bc",
    "typeParameter": "#bb9dbd",
    "parameter": "#bb9dbd",
    "variable": "#cdcdcd",
    "variable.readonly": "#aeaed1",
    "property": "#c3c3d5",
    "enumMember": "#aeaed1",
    "function": "#c48282",
    "method": "#c48282",
    "macro": "#bb9dbd",
    "keyword": "#6e94b2",
    "modifier": "#6e94b2",
    "comment": { "foreground": "#606079", "fontStyle": "italic" },
    "string": "#e8b589",
    "number": "#e0a363",
    "regexp": "#e0a363",
    "operator": "#90a0b5",
    "decorator": "#f3be7c",
    "*.defaultLibrary": "#b4d4cf",
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
